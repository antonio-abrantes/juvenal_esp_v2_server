# Importar no Portainer (Load variables from .env file). Não versionar valores reais.
# Alternativamente, importe seu .env existente do servidor; os caminhos do container são fixados no YAML.
JUVENAL_IMAGE=ghcr.io/antonio-abrantes/juvenal_esp_v2_server
JUVENAL_IMAGE_TAG=latest
# Para dev: JUVENAL_IMAGE_TAG=dev. Pode fixar uma versão, por exemplo 0.1.0-dev.
JUVENAL_DOMAIN=
TRAEFIK_NETWORK=network_public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencryptresolver
JUVENAL_BIND_IP=127.0.0.1
JUVENAL_HTTP_PORT=8000
PANEL_USERNAME=
PANEL_PASSWORD=
ESP_DEVICE_TOKEN=
# Abaixo, preencher o provedor/chaves/modelo reais. Não há segredo neste exemplo.
TZ=America/Sao_Paulo
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
WEBHOOK_URL=
WEBHOOK_API_KEY=
AUDIO_OUTPUT_MODE=esp32
STT_ENABLED=true
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=pt
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_TEMPERATURE=0.0
WHISPER_NO_SPEECH_THRESHOLD=0.7
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
PIPER_MODEL=pt_BR-faber-medium
PIPER_LENGTH_SCALE=1.0
PIPER_VOLUME=1.0
AUDIO_TEXT_ENDPOINT_URL=
AUDIO_TEXT_ENDPOINT_FORMAT=json
AUDIO_TEXT_ENDPOINT_SUCCESS_STATUSES=200,201,202
AUDIO_TEXT_ENDPOINT_TIMEOUT_SECONDS=10
AUDIO_TEXT_ENDPOINT_LOG_RESPONSE=false
AUDIO_TEXT_ENDPOINT_API_KEY=
AUDIO_TEXT_ENDPOINT_AUTH_HEADER=
AUDIO_TEXT_ENDPOINT_AUTH_PREFIX=
LOG_TRANSCRIPTS=false
ESP_DEVICE_ID=juvenal
ESP_LEGACY_ENABLED=false
ESP_VAD_START_RMS=300
ESP_VAD_END_RMS=100
ESP_VAD_SILENCE_SECONDS=1.8
ESP_MAX_INPUT_SECONDS=30
ESP_MAX_PLAYBACK_SECONDS=60
ESP_HANDSHAKE_SECONDS=5
CONVERSATION_IDLE_TIMEOUT_SECONDS=10
CONVERSATION_TIMEOUT=15
ESP_SILENCE_TIMEOUT=1.8
IDLE_MESSAGE_ENABLED=true
IDLE_MESSAGE="Estou voltando ao modo de espera. Me chame quando precisar!"
CONTEXT_MAX_MESSAGES=20
CONTEXT_MAX_BYTES=65536
CONTEXT_TTL_SECONDS=1800
CONTEXT_MAX_COUNT=8
RESPONSE_MAX_BYTES=32768
TOKEN_QUEUE_MAX_BYTES=65536
LLM_TIMEOUT_SECONDS=60
INTERACTION_TIMEOUT_SECONDS=180
DELIVERY_TIMEOUT_SECONDS=60
HASS_ENABLED=true
HASS_MODE=api
HASS_API_ENDPOINT=
HASS_API_TOKEN=
HASS_AGENT_ID=conversation.extended_openai_conversation_2
HASS_REQUEST_TIMEOUT_SECONDS=30
HASS_LOG_CONTENT=false
HASS_REQUIRE_CATALOG=false
HASS_TEXT_ENDPOINT_URL=
HASS_TEXT_ENDPOINT_FIELD=mensagem
HASS_TEXT_ENDPOINT_API_KEY=
HASS_TEXT_ENDPOINT_AUTH_HEADER=
HASS_TEXT_ENDPOINT_AUTH_PREFIX=
TOOLS_ENABLED=false
LLM_TOOL_CALLING_CONFIRMED=false
LLM_TOOL_CALLING_PROVIDER=
LLM_TOOL_CALLING_MODEL=
LLM_TOOL_CALLING_ADAPTER=openai-chat-completions
TOOL_TIMEOUT_SECONDS=15
TOOL_CONFIRMATION_TTL_SECONDS=60
TOOL_MAX_ROUNDS=3
TOOL_MAX_CALLS=4
AUTOMATION_CATALOG_MAX_BYTES=262144
AUTOMATION_CATALOG_MAX_ENTRIES=200
# Para usar HA: habilitar TOOLS_ENABLED e LLM_TOOL_CALLING_CONFIRMED,
# definir LLM_TOOL_CALLING_PROVIDER/MODEL iguais ao provedor/modelo em uso.
# HASS_REQUIRE_CATALOG=false já dispensa cadastro de ações.

# Consultas independentes do Home Assistant; busca nativa pela biblioteca DDGS.
INTERNET_ENABLED=false
WEATHER_ENABLED=true
CURRENCY_ENABLED=true
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEATHER_DEFAULT_LOCATION=
INTERNET_TIMEOUT_SECONDS=8
INTERNET_MAX_RESULTS=3
INTERNET_CACHE_TTL_SECONDS=300
INTERNET_LOG_CONTENT=false
