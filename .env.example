# Modelo de instalação nova. Não substituir um .env existente.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# Opcional, por exemplo para Ollama acessível de um container:
# OLLAMA_BASE_URL=http://ollama:11434/v1
# openai: OPENAI_API_KEY, OPENAI_MODEL, OPENAI_BASE_URL
# groq: GROQ_API_KEY, GROQ_MODEL
# custom: CUSTOM_LLM_BASE_URL, CUSTOM_LLM_API_KEY, CUSTOM_LLM_MODEL
# webhook conversacional: WEBHOOK_URL e WEBHOOK_API_KEY; message -> response

AUDIO_OUTPUT_MODE=local
LOCAL_VOICE_ENABLED=true
STT_ENABLED=true
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# endpoint: não carrega TTS; estes campos são da entrega, não da ferramenta HA.
AUDIO_TEXT_ENDPOINT_URL=
AUDIO_TEXT_ENDPOINT_FORMAT=json
# json usa {"texto": "resposta"}; text envia UTF-8 text/plain.
AUDIO_TEXT_ENDPOINT_SUCCESS_STATUSES=200,201,202
AUDIO_TEXT_ENDPOINT_TIMEOUT_SECONDS=10
# Exibir corpo do retorno HTTP apenas para diagnóstico (limite de 4096 bytes).
AUDIO_TEXT_ENDPOINT_LOG_RESPONSE=false
# Exibir texto reconhecido antes da chamada à IA; habilitar deliberadamente.
LOG_TRANSCRIPTS=false
AUDIO_TEXT_ENDPOINT_API_KEY=
AUDIO_TEXT_ENDPOINT_AUTH_HEADER=
AUDIO_TEXT_ENDPOINT_AUTH_PREFIX=
# Se houver API Key, preencher nome do header exigido pelo receptor.
# Exemplo de contrato Bearer, somente se confirmado: header Authorization, prefixo "Bearer ".
# Não configurar TTS_HA_WEBHOOK_URL em instalação nova. Ver migração em docs/configuration.md.

# STT: whisper mantém a baseline; parakeet seleciona o candidato PT-BR ONNX/INT8.
ASR_BACKEND=whisper
PARAKEET_MODEL=alefiury/parakeet-tdt-v3-ptBR-30s-onnx
# 0 mantém a seleção do runtime; medir antes de ajustar no Orange Pi.
PARAKEET_CPU_THREADS=0
# Comparação manual opt-in. Gravações/textos podem conter dados privados.
ASR_DIAGNOSTICS_ENABLED=false
ASR_SAVE_AUDIO=false
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=pt
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_TEMPERATURE=0.0
WHISPER_NO_SPEECH_THRESHOLD=0.7
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
WAKE_WORD_MODEL=models/juvehnal.tflite
WAKE_WORD_THRESHOLD=0.97
TTS_BACKEND=piper
PIPER_MODEL=pt_BR-faber-medium
PIPER_LENGTH_SCALE=1.0
PIPER_VOLUME=1.0
PIPER_USE_CUDA=false

# Captura local/legada do host; nao controla inatividade WS v1.
CONVERSATION_TIMEOUT=15
# Inatividade WS v1: somente o Python controla; editar e reiniciar o servidor.
CONVERSATION_IDLE_TIMEOUT_SECONDS=10
ESP_SILENCE_TIMEOUT=1.8
IDLE_MESSAGE_ENABLED=true
IDLE_MESSAGE="Estou voltando ao modo de espera. Me chame quando precisar!"
SYSTEM_PROMPT_PATH=configs/system_prompt.md
JUVENAL_DATA_DIR=data
CONTEXT_MAX_MESSAGES=20
CONTEXT_MAX_BYTES=65536
CONTEXT_TTL_SECONDS=1800
CONTEXT_MAX_COUNT=8
RESPONSE_MAX_BYTES=32768
TOKEN_QUEUE_MAX_BYTES=65536
LLM_TIMEOUT_SECONDS=60
INTERACTION_TIMEOUT_SECONDS=180
DELIVERY_TIMEOUT_SECONDS=60

JUVENAL_HOST=0.0.0.0
JUVENAL_PORT=8000
# Sem credenciais, controles de escrita do painel só aceitam conexão loopback.
# Para operar pela LAN, definir ambos e acessar / para autenticar via Basic HTTP.
PANEL_USERNAME=
PANEL_PASSWORD=
# Obrigatório para WS v1 e para habilitar o adaptador legado. Token igual no ESP.
ESP_DEVICE_ID=juvenal
ESP_DEVICE_TOKEN=
# ESP v1 usa /ws/esp; legado só em /ws/esp/legacy quando habilitado explicitamente.
ESP_LEGACY_ENABLED=false
ESP_VAD_START_RMS=300
ESP_VAD_END_RMS=100
ESP_VAD_SILENCE_SECONDS=1.8
ESP_MAX_INPUT_SECONDS=30
ESP_MAX_PLAYBACK_SECONDS=60
ESP_HANDSHAKE_SECONDS=5
# Opcional no ambiente do processo: JUVENAL_ENV_FILE aponta para dotenv externo.

# Consultas de leitura independentes do HA. Ver docs/internet.md.
INTERNET_ENABLED=false
WEATHER_ENABLED=true
CURRENCY_ENABLED=true
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEATHER_DEFAULT_LOCATION=
INTERNET_TIMEOUT_SECONDS=8
INTERNET_MAX_RESULTS=3
INTERNET_CACHE_TTL_SECONDS=300
INTERNET_LOG_CONTENT=false

# Eventos externos — EV-01: somente fila/status; não fala nem executa ações ainda.
# POST /api/events e GET /api/events/JOB_ID usam o header apikey (sem Bearer).
EVENTS_ENABLED=false
EVENTS_API_KEY=
# Vazio reutiliza ESP_DEVICE_ID; esta versão atende só o ESP já configurado.
EVENTS_DEFAULT_DEVICE_ID=
EVENTS_HUMANIZE_DEFAULT=true
EVENTS_DEFAULT_TTL_SECONDS=300
EVENTS_QUEUE_MAX=100
EVENTS_RETENTION_DAYS=7
EVENTS_LOG_CONTENT=false
# Ações por webhook serão implementadas na EV-04; manter false nesta etapa.
EVENTS_ACTIONS_ENABLED=false

# Home Assistant: API direta por padrão. Nunca colocar token no firmware.
HASS_ENABLED=true
HASS_MODE=api
# Raiz http(s) da instância, ou URL completa terminada em /api/conversation/process.
HASS_API_ENDPOINT=
HASS_API_TOKEN=
HASS_AGENT_ID=conversation.extended_openai_conversation_2
HASS_REQUEST_TIMEOUT_SECONDS=30
# Metadados HTTP sempre no log. Conteúdo de payload/resposta pode conter dados privados.
HASS_LOG_CONTENT=false
# false: IA do HA interpreta o comando diretamente, sem cadastro no Juvenal.
# true: exigir catálogo/permissões de ações cadastradas no painel.
HASS_REQUIRE_CATALOG=false
# Alternativa HASS_MODE=text_endpoint: receptor executa e fala; ESP fica sem TTS nessa ação.
HASS_TEXT_ENDPOINT_URL=
# JSON {"mensagem": "comando autorizado"}; ajustar ao contrato do receptor.
HASS_TEXT_ENDPOINT_FIELD=mensagem
HASS_TEXT_ENDPOINT_API_KEY=
HASS_TEXT_ENDPOINT_AUTH_HEADER=
HASS_TEXT_ENDPOINT_AUTH_PREFIX=

# Ferramentas: preservar confirmação explícita do suporte do provedor/modelo.
TOOLS_ENABLED=false
LLM_TOOL_CALLING_CONFIRMED=false
LLM_TOOL_CALLING_PROVIDER=
LLM_TOOL_CALLING_MODEL=
LLM_TOOL_CALLING_ADAPTER=openai-chat-completions
# HA_AUTOMATION_* é legado; configurar os dois modos acima com HASS_*.
TOOL_TIMEOUT_SECONDS=15
TOOL_CONFIRMATION_TTL_SECONDS=60
TOOL_MAX_ROUNDS=3
TOOL_MAX_CALLS=4
AUTOMATION_CATALOG_MAX_BYTES=262144
AUTOMATION_CATALOG_MAX_ENTRIES=200
