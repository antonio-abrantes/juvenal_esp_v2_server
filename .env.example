# Modelo de instalação nova. Não substituir um .env existente.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# openai: OPENAI_API_KEY, OPENAI_MODEL, OPENAI_BASE_URL
# groq: GROQ_API_KEY, GROQ_MODEL
# custom: CUSTOM_LLM_BASE_URL, CUSTOM_LLM_API_KEY, CUSTOM_LLM_MODEL
# webhook conversacional: WEBHOOK_URL e WEBHOOK_API_KEY; message -> response

AUDIO_OUTPUT_MODE=local
LOCAL_VOICE_ENABLED=true
STT_ENABLED=true
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# endpoint: não carrega TTS; estes campos são da entrega, não da ferramenta HA.
AUDIO_TEXT_ENDPOINT_URL=
AUDIO_TEXT_ENDPOINT_FORMAT=json
# json usa {"texto": "resposta"}; text envia UTF-8 text/plain.
AUDIO_TEXT_ENDPOINT_SUCCESS_STATUSES=200,201,202
AUDIO_TEXT_ENDPOINT_TIMEOUT_SECONDS=10
# Exibir corpo do retorno HTTP apenas para diagnóstico (limite de 4096 bytes).
AUDIO_TEXT_ENDPOINT_LOG_RESPONSE=false
# Exibir texto reconhecido antes da chamada à IA; habilitar deliberadamente.
LOG_TRANSCRIPTS=false
AUDIO_TEXT_ENDPOINT_API_KEY=
AUDIO_TEXT_ENDPOINT_AUTH_HEADER=
AUDIO_TEXT_ENDPOINT_AUTH_PREFIX=
# Se houver API Key, preencher nome do header exigido pelo receptor.
# Exemplo de contrato Bearer, somente se confirmado: header Authorization, prefixo "Bearer ".
# Não configurar TTS_HA_WEBHOOK_URL em instalação nova. Ver migração em docs/configuration.md.

WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=pt
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_TEMPERATURE=0.0
WHISPER_NO_SPEECH_THRESHOLD=0.7
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
WAKE_WORD_MODEL=models/juvehnal.tflite
WAKE_WORD_THRESHOLD=0.97
TTS_BACKEND=piper
PIPER_MODEL=pt_BR-faber-medium
PIPER_LENGTH_SCALE=1.0
PIPER_VOLUME=1.0
PIPER_USE_CUDA=false

CONVERSATION_TIMEOUT=15
ESP_SILENCE_TIMEOUT=1.8
IDLE_MESSAGE_ENABLED=true
IDLE_MESSAGE="Estou voltando ao modo de espera. Me chame quando precisar!"
SYSTEM_PROMPT_PATH=configs/system_prompt.md
JUVENAL_DATA_DIR=data
CONTEXT_MAX_MESSAGES=20
CONTEXT_MAX_BYTES=65536
CONTEXT_TTL_SECONDS=1800
CONTEXT_MAX_COUNT=8
RESPONSE_MAX_BYTES=32768
TOKEN_QUEUE_MAX_BYTES=65536
LLM_TIMEOUT_SECONDS=60
INTERACTION_TIMEOUT_SECONDS=180
DELIVERY_TIMEOUT_SECONDS=60

JUVENAL_HOST=0.0.0.0
JUVENAL_PORT=8000
# Sem credenciais, controles de escrita do painel só aceitam conexão loopback.
# Para operar pela LAN, definir ambos e acessar / para autenticar via Basic HTTP.
PANEL_USERNAME=
PANEL_PASSWORD=
# Opcional no adaptador legado; WS v1 autenticado será entregue na fase 03.
ESP_DEVICE_ID=juvenal
ESP_DEVICE_TOKEN=
